<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Review_Status__c</fullName>
    <label>Review Status</label>
    <description>Human review outcome for this concept candidate. The Concept Review Screen Flow updates this field.</description>
    <inlineHelpText>Set via the Concept Review Flow. Only Approved concepts proceed to insight generation.</inlineHelpText>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending</fullName>
                <default>true</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Approved</fullName>
                <default>false</default>
                <label>Approved</label>
            </value>
            <value>
                <fullName>Rejected</fullName>
                <default>false</default>
                <label>Rejected</label>
            </value>
            <value>
                <fullName>NeedsEdit</fullName>
                <default>false</default>
                <label>Needs Edit</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
