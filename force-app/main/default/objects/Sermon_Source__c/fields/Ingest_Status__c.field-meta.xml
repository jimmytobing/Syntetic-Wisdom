<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ingest_Status__c</fullName>
    <label>Ingest Status</label>
    <description>Lifecycle state of this sermon source within the ingestion pipeline. The Record-Triggered Flow watches for Pending to kick off a Transcript Job.</description>
    <inlineHelpText>Pending triggers automated processing. Do not set to Done or Error manually unless correcting a stuck record.</inlineHelpText>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending</fullName>
                <default>true</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Processing</fullName>
                <default>false</default>
                <label>Processing</label>
            </value>
            <value>
                <fullName>Done</fullName>
                <default>false</default>
                <label>Done</label>
            </value>
            <value>
                <fullName>Error</fullName>
                <default>false</default>
                <label>Error</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
