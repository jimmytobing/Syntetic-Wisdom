<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Tracks a single transcript extraction job tied to a Sermon Source. Records the processing stage, error details, and chunk count. Commonly used for pipeline monitoring, error triage, and job lifecycle tracking.</description>
    <label>Transcript Job</label>
    <pluralLabel>Transcript Jobs</pluralLabel>
    <nameField>
        <label>Job Number</label>
        <type>AutoNumber</type>
        <displayFormat>JOB-{0000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
    <sharingModel>ReadWrite</sharingModel>
    <deploymentStatus>Deployed</deploymentStatus>
    <visibility>Public</visibility>
    <enableSearch>true</enableSearch>
    <enableReports>true</enableReports>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
</CustomObject>
