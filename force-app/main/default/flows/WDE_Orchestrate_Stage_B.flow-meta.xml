<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
        <decisions>
        <name>Check_Batch_State</name><label>Process only expected Stage B state</label>
        <locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>END_ELEMENT_4</targetReference></defaultConnector>
        <defaultConnectorLabel>Stale or already processed</defaultConnectorLabel>
        <rules><name>Ready_For_B</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Batch.Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>BoundariesApproved</stringValue></rightValue></conditions>
            <connector><targetReference>Get_Open_Segment</targetReference></connector><label>Expected state</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_B</name>
        <label>B succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decide_Retry_B</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other result / failed</defaultConnectorLabel>
        <rules>
            <name>B_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>bResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUCCESS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_B_Review</targetReference>
            </connector>
            <label>B_Success</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Retry_B</name><label>Retry bounded invalid enrichment</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Set_B_Failure</targetReference></defaultConnector><defaultConnectorLabel>Fail closed</defaultConnectorLabel>
        <rules><name>Retry_Enrichment</name><conditionLogic>and</conditionLogic>
          <conditions><leftValueReference>f_B_RetryEligible</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
          <connector><targetReference>Set_B_Retry_Pending</targetReference></connector><label>Bounded retry</label>
        </rules>
    </decisions>
    
    <description>Autolaunched orchestration extracted from Stage B async trigger. Owns the worker, status transitions, retry handling, and persisted batch errors. Issue 53.</description>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    
    
    

    <formulas>
        <name>f_B_RetryEligible</name><dataType>Boolean</dataType>
        <expression>AND(
          BLANKVALUE({!Get_Batch.Retry_Count__c},0) &lt; 3,
          NOT(ISBLANK({!Get_Batch.Approved_Boundaries__c})),
          OR(
            {!bResult} = "INVALID_AI_FORMAT",
            {!bResult} = "EMPTY_RESPONSE",
            AND({!bResult} = "GROQ_ERROR",
              OR(CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"429"),
                 CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"500"),
                 CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"502"),
                 CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"503"),
                 CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"504"),
                 CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"too many requests"))),
            AND({!bResult} = "FLOW_FAULT",
              OR(CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"timeout"),
                 CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"connection"),
                 CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"temporar")))
          )
        )</expression>
    </formulas>
    <formulas><name>f_B_NextRetry</name><dataType>Number</dataType><scale>0</scale>
       <expression>BLANKVALUE({!Get_Batch.Retry_Count__c},0) + 1</expression>
    </formulas>
    <formulas><name>f_B_NextRetryAt</name><dataType>DateTime</dataType>
       <expression>NOW() + IF(
           OR(CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"daily"),
              CONTAINS(LOWER(BLANKVALUE({!varT_Error},"")),"per day")),
           1440,
           CASE(TEXT(BLANKVALUE({!Get_Batch.Retry_Count__c},0)), "0", 1, "1", 5, 15)
         ) / 1440</expression>
    </formulas>
    <interviewLabel>WDE Orchestrate Stage B {!$Flow.CurrentDateTime}</interviewLabel>
    <label>WDE Orchestrate Stage B</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
        <recordLookups>
        <name>Get_Batch</name><label>Get originating batch</label>
        <locationX>0</locationX><locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_Batch_State</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varRecordId</elementReference></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WDE_Batch_Run__c</object><storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Segment</name>
        <label>Get Open Segment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Call_B</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Sermon_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Batch.Sermon_Source__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>WDE_Stitch_Open__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sermon_Segment__c</object>
        <sortField>End_Index__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Set_B_Failure</name>
        <label>Stage B failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Batch.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Error_Message__c</field>
            <value>
                <elementReference>varT_Error</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    
    <recordUpdates>
        <name>Set_B_Review</name>
        <label>Hold validated enrichment pending independent QA commit release</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_6</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Batch.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Approved_Enrichment__c</field>
            <value>
                <elementReference>bLines</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>NeedsCommitReview</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_B_Retry_Pending</name><label>Schedule Stage B retry without rerunning boundaries</label><locationX>0</locationX><locationY>0</locationY>
        <connector><targetReference>END_ELEMENT_5</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>Get_Batch.Id</elementReference></value></filters>
        <inputAssignments><field>Retry_Count__c</field><value><elementReference>f_B_NextRetry</elementReference></value></inputAssignments>
        <inputAssignments><field>Next_Retry_At__c</field><value><elementReference>f_B_NextRetryAt</elementReference></value></inputAssignments>
        <inputAssignments><field>Error_Message__c</field><value><elementReference>varT_Error</elementReference></value></inputAssignments>
        <inputAssignments><field>Status__c</field><value><stringValue>RetryPending</stringValue></value></inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    <start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Get_Batch</targetReference></connector></start>
