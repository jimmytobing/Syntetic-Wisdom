<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
<apiVersion>68.0</apiVersion>
<areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
<description>Deterministic no-callout test harness for the SAME pure retry decision used by production audio QA. Input scenario HTTP_429/TIMEOUT/MALFORMED, prior attempt 0/1/2. Does not fake provider HTTP responses or write Sermon Segments. Execute three independent interviews, record output as test evidence; transport fault handling requires separate integration test.</description>
<assignments><name>Calculate_Attempt</name><label>Increment simulated prior attempt by one</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varN_NextAttempt</assignToReference><operator>Assign</operator><value><elementReference>f_NextAttempt</elementReference></value></assignmentItems><connector><targetReference>Decide_Retry</targetReference></connector></assignments>
<assignments><name>Capture_Status</name><label>Capture shared decision</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varT_NextStatus</assignToReference><operator>Assign</operator><value><elementReference>Decide_Retry.varT_NextStatus</elementReference></value></assignmentItems></assignments>
<assignments><name>Invalid_Scenario</name><label>Reject unexpected failure category</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varT_NextStatus</assignToReference><operator>Assign</operator><value><stringValue>INVALID_TEST_INPUT</stringValue></value></assignmentItems></assignments>
<decisions><name>Validate_Scenario</name><label>Only explicitly simulated technical error categories</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Invalid_Scenario</targetReference></defaultConnector><defaultConnectorLabel>Invalid</defaultConnectorLabel><rules><name>Allowed</name><conditionLogic>1 OR 2 OR 3</conditionLogic><conditions><leftValueReference>varT_FailureMode</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>HTTP_429</stringValue></rightValue></conditions><conditions><leftValueReference>varT_FailureMode</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>TIMEOUT</stringValue></rightValue></conditions><conditions><leftValueReference>varT_FailureMode</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>MALFORMED</stringValue></rightValue></conditions><connector><targetReference>Calculate_Attempt</targetReference></connector><label>Valid test category</label></rules></decisions>
<environments>Default</environments>
<formulas><name>f_NextAttempt</name><dataType>Number</dataType><scale>0</scale><expression>BLANKVALUE({!varN_PriorAttempts},0)+1</expression></formulas>
<interviewLabel>WDE QA Recovery Harness {!$Flow.CurrentDateTime}</interviewLabel><label>WDE Test Audio QA Recovery</label><processType>AutoLaunchedFlow</processType>
<start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Validate_Scenario</targetReference></connector></start>
<status>Active</status>
<subflows><name>Decide_Retry</name><label>Production shared retry decision</label><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Capture_Status</targetReference></connector><flowName>WDE_Audio_QA_Decide_Retry</flowName><inputAssignments><name>varN_NextAttempt</name><value><elementReference>varN_NextAttempt</elementReference></value></inputAssignments><storeOutputAutomatically>true</storeOutputAutomatically></subflows>
<variables><name>varT_FailureMode</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
<variables><name>varN_PriorAttempts</name><dataType>Number</dataType><scale>0</scale><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
<variables><name>varN_NextAttempt</name><dataType>Number</dataType><scale>0</scale><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
<variables><name>varT_NextStatus</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
</Flow>
