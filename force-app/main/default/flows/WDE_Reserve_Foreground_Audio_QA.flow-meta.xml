<description>SECURITY_REVIEW_REQUIRED. Manual unique one-segment claim followed by one direct foreground subflow, never AsyncAfterCommit. The duplicate Create fails before any provider call. ExternalService Automatic transaction control commits the claim before POST. Not guaranteed against platform continuation replay or unauthorized direct worker invocation. Do not activate until the one-time dispatch boundary and permissions are reviewed. Never write QA verdict.</description>
<assignments><name>Accept_Claim</name><label>Return claim and dispatch via subflow only after successful unique create</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varS_Result</assignToReference><operator>Assign</operator><value><stringValue>CLAIM_CREATED_ONCE</stringValue></value></assignmentItems><assignmentItems><assignToReference>varS_ClaimId</assignToReference><operator>Assign</operator><value><elementReference>Create_Claim.Id</elementReference></value></assignmentItems><connector><targetReference>Dispatch_Once</targetReference></connector></assignments>
<assignments><name>Duplicate_Or_Fault</name><label>Any create fault blocks new provider work</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varS_Result</assignToReference><operator>Assign</operator><value><stringValue>CLAIM_CREATE_FAILED_DO_NOT_RETRY</stringValue></value></assignmentItems></assignments>
<assignments><name>Reject_Input</name><label>Reject source without any provider call</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varS_Result</assignToReference><operator>Assign</operator><value><stringValue>INELIGIBLE_SOURCE_OR_SEGMENT</stringValue></value></assignmentItems></assignments>
<decisions><name>Check_Segment</name><label>Enforce closed failed QA and bounded offset</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Reject_Input</targetReference></defaultConnector><defaultConnectorLabel>Unsafe input</defaultConnectorLabel><rules><name>Eligible</name><conditionLogic>and</conditionLogic>
<conditions><leftValueReference>Get_Segment.Id</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
<conditions><leftValueReference>Get_Segment.Audio_QA_Required__c</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
<conditions><leftValueReference>Get_Segment.Audio_QA_Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>SYSTEM_ERROR</stringValue></rightValue></conditions>
<conditions><leftValueReference>Get_Segment.WDE_Stitch_Open__c</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
<conditions><leftValueReference>f_Bounded</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
<conditions><leftValueReference>f_TranscriptValid</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
<conditions><leftValueReference>Get_Segment.Sermon_Source__c</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
<connector><targetReference>Get_Source</targetReference></connector><label>Eligible</label></rules></decisions>
<decisions><name>Check_Source</name><label>Require explicit source permission</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Reject_Input</targetReference></defaultConnector><defaultConnectorLabel>Source not consented</defaultConnectorLabel><rules><name>Rights_OK</name><conditionLogic>and</conditionLogic>
<conditions><leftValueReference>Get_Source.Id</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
<conditions><leftValueReference>Get_Source.Rights_Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>PermissionGranted</stringValue></rightValue></conditions>
<conditions><leftValueReference>f_SourceValid</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
<connector><targetReference>Create_Claim</targetReference></connector><label>Authorized</label></rules></decisions>
<formulas><name>f_ClaimKey</name><dataType>String</dataType><expression>{!Get_Segment.Id}</expression></formulas>
<formulas><name>f_StartMs</name><dataType>Number</dataType><scale>0</scale><expression>{!Get_Segment.Start_Ms__c}</expression></formulas>
<formulas><name>f_EndMs</name><dataType>Number</dataType><scale>0</scale><expression>MIN({!Get_Segment.End_Ms__c}, {!Get_Segment.Start_Ms__c} + 30000)</expression></formulas>
<formulas><name>f_Bounded</name><dataType>Boolean</dataType><expression>AND({!Get_Segment.End_Ms__c} &gt; {!Get_Segment.Start_Ms__c}, {!Get_Segment.Start_Ms__c} &gt;= 0)</expression></formulas>
<formulas><name>f_SourceValid</name><dataType>Boolean</dataType><expression>AND(LEN({!Get_Source.External_Video_Id__c})=11,REGEX({!Get_Source.External_Video_Id__c},"[A-Za-z0-9_-]{11}"))</expression></formulas>
<formulas><name>f_TranscriptValid</name><dataType>Boolean</dataType><expression>AND(LEN(TRIM({!Get_Segment.Transcript_Text__c})) &gt; 0, LEN({!Get_Segment.Transcript_Text__c}) &lt;= 25000)</expression></formulas>
<formulas><name>f_SourceSignature</name><dataType>String</dataType><expression>LEFT({!Get_Segment.Id} &amp; "-" &amp; TEXT({!Get_Segment.Start_Ms__c}) &amp; "-" &amp; TEXT({!f_EndMs}),64)</expression></formulas>
