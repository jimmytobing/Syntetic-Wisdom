<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
<apiVersion>68.0</apiVersion>
<description>Recalculate 28-day HIVE from coded YouTube comment evidence (urgency/detail v1), volume, growth, recency; fail closed on incomplete rubrics. No callouts, one update outside loop.</description>
<interviewLabel>WDE Recalculate HIVE {!$Flow.CurrentDateTime}</interviewLabel>
<label>WDE Recalculate HIVE</label>
<processType>AutoLaunchedFlow</processType>
<status>Active</status>
<variables><name>varS_NeedId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
<variables><name>varB_Success</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
<variables><name>varS_Error</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
<variables><name>varN_Volume28</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>0</scale><value><numberValue>0.0</numberValue></value></variables>
<variables><name>varN_Last7</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>0</scale><value><numberValue>0.0</numberValue></value></variables>
<variables><name>varN_Previous7</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>0</scale><value><numberValue>0.0</numberValue></value></variables>
<variables><name>varD_LatestDate</name><dataType>Date</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
<variables><name>varN_EvidencedCount</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>2</scale><value><numberValue>0.0</numberValue></value></variables>
<variables><name>varN_IntensityTotal</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>2</scale><value><numberValue>0.0</numberValue></value></variables>
<variables><name>varN_QualityTotal</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>2</scale><value><numberValue>0.0</numberValue></value></variables>
<variables><name>varN_FinalIntensity</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>2</scale></variables>
<variables><name>varN_FinalQuality</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>2</scale></variables>
<variables><name>varN_Blank</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>2</scale></variables>
<formulas><name>f_Today</name><dataType>Date</dataType><expression>TODAY()</expression></formulas>
<formulas><name>f_RubricIsValid</name><dataType>Boolean</dataType><expression>AND(LEN({!Loop_Recent_Signals.HIVE_Evidence_Codes__c})=8,RIGHT({!Loop_Recent_Signals.HIVE_Evidence_Codes__c},3)=&quot;|V1&quot;,CONTAINS(&quot;|U0|U1|U2|U3|U4|&quot;,&quot;|&quot; &amp; LEFT({!Loop_Recent_Signals.HIVE_Evidence_Codes__c},2) &amp; &quot;|&quot;),CONTAINS(&quot;|Q1|Q2|Q3|&quot;,&quot;|&quot; &amp; MID({!Loop_Recent_Signals.HIVE_Evidence_Codes__c},4,2) &amp; &quot;|&quot;))</expression></formulas>
<formulas><name>f_SignalIntensity</name><dataType>Number</dataType><expression>CASE(LEFT({!Loop_Recent_Signals.HIVE_Evidence_Codes__c},2),&quot;U0&quot;,0,&quot;U1&quot;,25,&quot;U2&quot;,50,&quot;U3&quot;,75,&quot;U4&quot;,100,0)</expression><scale>2</scale></formulas>
<formulas><name>f_SignalQuality</name><dataType>Number</dataType><expression>CASE(MID({!Loop_Recent_Signals.HIVE_Evidence_Codes__c},4,2),&quot;Q1&quot;,33.33,&quot;Q2&quot;,66.67,&quot;Q3&quot;,100,0)</expression><scale>2</scale></formulas>
<formulas><name>f_AverageIntensity</name><dataType>Number</dataType><expression>IF({!varN_EvidencedCount}=0,0,ROUND({!varN_IntensityTotal}/{!varN_EvidencedCount},2))</expression><scale>2</scale></formulas>
<formulas><name>f_AverageQuality</name><dataType>Number</dataType><expression>IF({!varN_EvidencedCount}=0,0,ROUND({!varN_QualityTotal}/{!varN_EvidencedCount},2))</expression><scale>2</scale></formulas>
<formulas><name>f_Window_Start</name><dataType>Date</dataType><expression>TODAY()-27</expression></formulas>
<formulas><name>f_Last7_Start</name><dataType>Date</dataType><expression>TODAY()-6</expression></formulas>
<formulas><name>f_Previous7_Start</name><dataType>Date</dataType><expression>TODAY()-13</expression></formulas>
<formulas><name>f_Volume</name><dataType>Number</dataType><expression>MIN(100, 100*{!varN_Volume28}/20)</expression><scale>2</scale></formulas>
<formulas><name>f_Growth</name><dataType>Number</dataType><expression>IF({!varN_Last7}=0, 0, IF({!varN_Previous7}=0, 100, MIN(100,MAX(0, 50+50*({!varN_Last7}-{!varN_Previous7})/{!varN_Previous7}))))</expression><scale>2</scale></formulas>
<formulas><name>f_Recency</name><dataType>Number</dataType><expression>IF(ISBLANK({!varD_LatestDate}),0,MAX(0,100-100*(TODAY()-{!varD_LatestDate})/28))</expression><scale>2</scale></formulas>
<formulas><name>f_Evaluation_Status</name><dataType>String</dataType><expression>IF({!varN_Volume28}&lt;3,&quot;Insufficient Data&quot;,IF({!varN_EvidencedCount}={!varN_Volume28},&quot;Ready&quot;,&quot;Incomplete&quot;))</expression></formulas>
<recordLookups><name>Get_Audience_Need</name><label>Get audience need by Id</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Need_Found</targetReference></connector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varS_NeedId</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>WDE_Audience_Need__c</object><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>
<recordLookups><name>Get_Recent_Signals</name><label>Get unique signals in last 28 days</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Has_Signals</targetReference></connector><filterLogic>and</filterLogic><filters><field>WDE_Audience_Need__c</field><operator>EqualTo</operator><value><elementReference>varS_NeedId</elementReference></value></filters><filters><field>Signal_Date__c</field><operator>GreaterThanOrEqualTo</operator><value><elementReference>f_Window_Start</elementReference></value></filters><filters><field>Signal_Date__c</field><operator>LessThanOrEqualTo</operator><value><elementReference>f_Today</elementReference></value></filters><getFirstRecordOnly>false</getFirstRecordOnly><object>WDE_Audience_Signal__c</object><sortField>Signal_Date__c</sortField><sortOrder>Desc</sortOrder><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>
<loops><name>Loop_Recent_Signals</name><label>Aggregate unique signals</label><locationX>0</locationX><locationY>0</locationY><collectionReference>Get_Recent_Signals</collectionReference><iterationOrder>Asc</iterationOrder><nextValueConnector><targetReference>Increment_Volume</targetReference></nextValueConnector><noMoreValuesConnector><targetReference>Evidence_Sufficient</targetReference></noMoreValuesConnector></loops>
<decisions><name>Evidence_Code_Valid</name><label>Only coded comment evidence from supported rubric</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Is_Last_Seven</targetReference></defaultConnector><defaultConnectorLabel>Missing or invalid</defaultConnectorLabel><rules><name>Valid_V1</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>f_RubricIsValid</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions><connector><targetReference>Increment_Evidence</targetReference></connector><label>Valid rubric V1</label></rules></decisions>
<decisions><name>Evidence_Sufficient</name><label>Require at least three signals and complete classification coverage</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Clear_Unverified_Rubric</targetReference></defaultConnector><defaultConnectorLabel>Incomplete</defaultConnectorLabel><rules><name>Complete</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>varN_Volume28</leftValueReference><operator>GreaterThanOrEqualTo</operator><rightValue><numberValue>3.0</numberValue></rightValue></conditions><conditions><leftValueReference>varN_EvidencedCount</leftValueReference><operator>EqualTo</operator><rightValue><elementReference>varN_Volume28</elementReference></rightValue></conditions><connector><targetReference>Set_Evidence_Averages</targetReference></connector><label>Complete</label></rules></decisions>
<decisions><name>Need_Found</name><label>Need found</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Set_Not_Found</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>Found</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Audience_Need.Id</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Get_Recent_Signals</targetReference></connector><label>Found</label></rules></decisions>
<decisions><name>Has_Signals</name><label>Any signal in period</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Clear_Unverified_Rubric</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>Nonempty</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Recent_Signals</leftValueReference><operator>IsEmpty</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Loop_Recent_Signals</targetReference></connector><label>Nonempty</label></rules></decisions>
<decisions><name>Is_Last_Seven</name><label>Was signal in last 7 days</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Is_Previous_Seven</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>Recent</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Loop_Recent_Signals.Signal_Date__c</leftValueReference><operator>GreaterThanOrEqualTo</operator><rightValue><elementReference>f_Last7_Start</elementReference></rightValue></conditions><connector><targetReference>Increment_Last7</targetReference></connector><label>Recent</label></rules></decisions>
<decisions><name>Is_Previous_Seven</name><label>Was signal in previous 7 days</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Store_Latest_If_Missing</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>Previous</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Loop_Recent_Signals.Signal_Date__c</leftValueReference><operator>GreaterThanOrEqualTo</operator><rightValue><elementReference>f_Previous7_Start</elementReference></rightValue></conditions><connector><targetReference>Increment_Previous7</targetReference></connector><label>Previous</label></rules></decisions>
<decisions><name>Store_Latest_If_Missing</name><label>First signal is newest</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Loop_Recent_Signals</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>No_Date_Yet</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>varD_LatestDate</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions><connector><targetReference>Set_Latest_Date</targetReference></connector><label>No Date Yet</label></rules></decisions>
<assignments><name>Increment_Evidence</name><label>Accumulate documented rubric scores</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varN_EvidencedCount</assignToReference><operator>Add</operator><value><numberValue>1.0</numberValue></value></assignmentItems><assignmentItems><assignToReference>varN_IntensityTotal</assignToReference><operator>Add</operator><value><elementReference>f_SignalIntensity</elementReference></value></assignmentItems><assignmentItems><assignToReference>varN_QualityTotal</assignToReference><operator>Add</operator><value><elementReference>f_SignalQuality</elementReference></value></assignmentItems><connector><targetReference>Is_Last_Seven</targetReference></connector></assignments>
<assignments><name>Set_Evidence_Averages</name><label>Set averages when complete</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varN_FinalIntensity</assignToReference><operator>Assign</operator><value><elementReference>f_AverageIntensity</elementReference></value></assignmentItems><assignmentItems><assignToReference>varN_FinalQuality</assignToReference><operator>Assign</operator><value><elementReference>f_AverageQuality</elementReference></value></assignmentItems><connector><targetReference>Update_Need</targetReference></connector></assignments>
<assignments><name>Clear_Unverified_Rubric</name><label>Clear previous unsupported scores (no stale Ready)</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varN_FinalIntensity</assignToReference><operator>Assign</operator><value><elementReference>varN_Blank</elementReference></value></assignmentItems><assignmentItems><assignToReference>varN_FinalQuality</assignToReference><operator>Assign</operator><value><elementReference>varN_Blank</elementReference></value></assignmentItems><connector><targetReference>Update_Need</targetReference></connector></assignments>
<assignments><name>Increment_Volume</name><label>Count one deduplicated actionable comment</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varN_Volume28</assignToReference><operator>Add</operator><value><numberValue>1.0</numberValue></value></assignmentItems><connector><targetReference>Evidence_Code_Valid</targetReference></connector></assignments>
<assignments><name>Increment_Last7</name><label>Count last 7 days</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varN_Last7</assignToReference><operator>Add</operator><value><numberValue>1.0</numberValue></value></assignmentItems><connector><targetReference>Store_Latest_If_Missing</targetReference></connector></assignments>
<assignments><name>Increment_Previous7</name><label>Count preceding 7 days</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varN_Previous7</assignToReference><operator>Add</operator><value><numberValue>1.0</numberValue></value></assignmentItems><connector><targetReference>Store_Latest_If_Missing</targetReference></connector></assignments>
<assignments><name>Set_Latest_Date</name><label>Capture latest signal date</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varD_LatestDate</assignToReference><operator>Assign</operator><value><elementReference>Loop_Recent_Signals.Signal_Date__c</elementReference></value></assignmentItems><connector><targetReference>Loop_Recent_Signals</targetReference></connector></assignments>

<assignments><name>Set_Success</name><label>Set success output</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varB_Success</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems></assignments>
<assignments><name>Set_Not_Found</name><label>Set missing need error</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><stringValue>Audience Need not found</stringValue></value></assignmentItems></assignments>
<assignments><name>Capture_Fault</name><label>Capture Salesforce DML fault</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems></assignments>
<recordUpdates><name>Update_Need</name><label>Persist HIVE metrics once outside loop</label><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Set_Success</targetReference></connector><faultConnector><targetReference>Capture_Fault</targetReference></faultConnector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varS_NeedId</elementReference></value></filters><inputAssignments><field>HIVE_Volume__c</field><value><elementReference>f_Volume</elementReference></value></inputAssignments><inputAssignments><field>HIVE_Growth__c</field><value><elementReference>f_Growth</elementReference></value></inputAssignments><inputAssignments><field>HIVE_Recency__c</field><value><elementReference>f_Recency</elementReference></value></inputAssignments><inputAssignments><field>HIVE_Intensity__c</field><value><elementReference>varN_FinalIntensity</elementReference></value></inputAssignments><inputAssignments><field>HIVE_Quality__c</field><value><elementReference>varN_FinalQuality</elementReference></value></inputAssignments><inputAssignments><field>HIVE_Evaluation_Status__c</field><value><elementReference>f_Evaluation_Status</elementReference></value></inputAssignments><inputAssignments><field>HIVE_Scored_At__c</field><value><elementReference>$Flow.CurrentDateTime</elementReference></value></inputAssignments><object>WDE_Audience_Need__c</object></recordUpdates>
<start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Get_Audience_Need</targetReference></connector></start>
</Flow>
