    <formulas>
        <name>f_Analogy</name>
        <dataType>String</dataType>
        <expression>
TRIM(
  MID(
    {!varA_WisdomOutput.content},
    FIND(&quot;[[ANALOGY]]&quot;, {!varA_WisdomOutput.content})
      + LEN(&quot;[[ANALOGY]]&quot;),
    FIND(&quot;[[/ANALOGY]]&quot;, {!varA_WisdomOutput.content})
      - FIND(&quot;[[ANALOGY]]&quot;, {!varA_WisdomOutput.content})
      - LEN(&quot;[[ANALOGY]]&quot;)
  )
)</expression>
    </formulas>
    <formulas>
        <name>f_ConceptContextLine</name>
        <dataType>String</dataType>
        <expression>
&quot;=== WISDOM CONCEPT ===&quot; &amp; BR() &amp;
&quot;Concept ID: &quot; &amp; {!Loop_Approved_Concepts.Id} &amp; BR() &amp;
&quot;Concept Name: &quot; &amp; {!Loop_Approved_Concepts.Name} &amp; BR() &amp;
&quot;Theme: &quot; &amp;
BLANKVALUE({!Loop_Approved_Concepts.Theme__c}, &quot;-&quot;) &amp; BR() &amp;
&quot;Concept Type: &quot; &amp;
TEXT({!Loop_Approved_Concepts.Concept_Type__c}) &amp; BR() &amp;
&quot;Core Principle: &quot; &amp;
BLANKVALUE(
  {!Loop_Approved_Concepts.Candidate_Summary__c},
  &quot;-&quot;
) &amp; BR() &amp;
&quot;=== END CONCEPT ===&quot; &amp; BR() &amp; BR()</expression>
    </formulas>
    <formulas>
        <name>f_IsStructuredResponse</name>
        <dataType>Boolean</dataType>
        <expression>
AND(
  CONTAINS({!varA_WisdomOutput.content}, &quot;[[ANALOGY]]&quot;),
  CONTAINS({!varA_WisdomOutput.content}, &quot;[[/ANALOGY]]&quot;),
  CONTAINS({!varA_WisdomOutput.content}, &quot;[[PRACTICAL_STEP]]&quot;),
  CONTAINS({!varA_WisdomOutput.content}, &quot;[[/PRACTICAL_STEP]]&quot;),
  FIND(&quot;[[/ANALOGY]]&quot;, {!varA_WisdomOutput.content})
    &gt; FIND(&quot;[[ANALOGY]]&quot;, {!varA_WisdomOutput.content}),
  FIND(&quot;[[/PRACTICAL_STEP]]&quot;, {!varA_WisdomOutput.content})
    &gt; FIND(&quot;[[PRACTICAL_STEP]]&quot;, {!varA_WisdomOutput.content})
)</expression>
    </formulas>
    <formulas>
        <name>f_PracticalStep</name>
        <dataType>String</dataType>
        <expression>
TRIM(
  MID(
    {!varA_WisdomOutput.content},
    FIND(&quot;[[PRACTICAL_STEP]]&quot;, {!varA_WisdomOutput.content})
      + LEN(&quot;[[PRACTICAL_STEP]]&quot;),
    FIND(&quot;[[/PRACTICAL_STEP]]&quot;, {!varA_WisdomOutput.content})
      - FIND(&quot;[[PRACTICAL_STEP]]&quot;, {!varA_WisdomOutput.content})
      - LEN(&quot;[[PRACTICAL_STEP]]&quot;)
  )
)</expression>
    </formulas>
