<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion><areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Issue 53: thin asynchronous Stage C trigger. All business DML, fault recovery and status transitions execute in the autolaunched orchestrator.</description>
    <decisions>
        <name>Check_Returned_Error</name><label>Orchestrator error check</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>END_ASYNC</targetReference></defaultConnector><defaultConnectorLabel>No returned error</defaultConnectorLabel>
        <rules><name>Error_Returned</name><conditionLogic>and</conditionLogic>
          <conditions><leftValueReference>f_Has_Error</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
          <connector><targetReference>END_ASYNC_ERROR</targetReference></connector><label>Error persisted by orchestrator</label>
        </rules>
    </decisions>
    <ends><name>END_SYNC</name><locationX>0</locationX><locationY>0</locationY></ends>
    <ends><name>END_ASYNC</name><locationX>0</locationX><locationY>0</locationY></ends><ends><name>END_ASYNC_ERROR</name><locationX>0</locationX><locationY>0</locationY></ends>
    <formulas><name>f_Has_Error</name><dataType>Boolean</dataType><expression>NOT(ISBLANK({!varT_Error}))</expression></formulas>
    <interviewLabel>[Tgr] WDE Run Stage C {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Tgr] WDE Run Stage C</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_SYNC</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CommitApproved</stringValue>
            </value>
        </filters>
        <object>WDE_Batch_Run__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Run_Orchestrator</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows><name>Run_Orchestrator</name><label>Run Stage C orchestrator</label><locationX>0</locationX><locationY>0</locationY>
       <connector><targetReference>Check_Returned_Error</targetReference></connector>
       <flowName>WDE_Orchestrate_Stage_C</flowName>
       <inputAssignments><name>varRecordId</name><value><elementReference>$Record.Id</elementReference></value></inputAssignments>
       <outputAssignments><assignToReference>varT_Error</assignToReference><name>varT_Error</name></outputAssignments>
    </subflows>
    <variables><name>varT_Error</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
</Flow>