<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_C</name>
        <label>C succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_C_Failure</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other result / failed</defaultConnectorLabel>
        <rules>
            <name>C_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>cResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUCCESS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_C_Complete</targetReference>
            </connector>
            <label>C_Success</label>
        </rules>
    </decisions>
    <description>WDE Batch 8 pilot — asynchronous stage C; no automatic approval. Deploy inactive and validate in sandbox first.</description>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>[Tgr] WDE Run Stage C {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Tgr] WDE Run Stage C</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_C_Complete</name>
        <label>Batch completed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Next_Start_Position__c</field>
            <value>
                <elementReference>cNext</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_C_Failure</name>
        <label>Stage C failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_6</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Error_Message__c</field>
            <value>
                <elementReference>cError</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CommitApproved</stringValue>
            </value>
        </filters>
        <object>WDE_Batch_Run__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Call_C</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_C</name>
        <label>Call_C</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_C</targetReference>
        </connector>
        <flowName>WDE_Persist_Reviewed_Segments</flowName>
        <inputAssignments>
            <name>varSermonSourceId</name>
            <value>
                <elementReference>$Record.Sermon_Source__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varStartPosition</name>
            <value>
                <elementReference>$Record.Start_Position__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varMaxBatchCharacters</name>
            <value>
                <elementReference>$Record.Max_Batch_Characters__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varApprovedEnrichmentLines</name>
            <value>
                <elementReference>$Record.Approved_Enrichment__c</elementReference>
            </value>
        </inputAssignments>
        
        <inputAssignments>
            <name>varCommitRecords</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>cResult</assignToReference>
            <name>varResultStatus</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>cError</assignToReference>
            <name>varErrorMessage</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>cNext</assignToReference>
            <name>varNextStartPosition</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>cError</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>cNext</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>cResult</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
