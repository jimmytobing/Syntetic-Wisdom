<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Autolaunched Flow for bulk-publishing eligible Wisdom Insights. Finds all insights with Review_Status = Approved, Safety_Status = Safe, and Published_Status = Unpublished, then sets Published_Status = Published in a single DML operation. Must be invoked manually by an admin after human review is complete. Safe to run when no records qualify (0-row update is a no-op). Does not check rights at this stage — rights are verified upstream at the Sermon Source level.</description>
    <interviewLabel>Wisdom Insight Publish {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Wisdom Insight Publish</label>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>PublishApprovedInsights</targetReference>
        </connector>
    </start>
    <recordUpdates>
        <name>PublishApprovedInsights</name>
        <label>Publish Approved and Safe Insights</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Review_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Safety_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Safe</stringValue>
            </value>
        </filters>
        <filters>
            <field>Published_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Unpublished</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Published_Status__c</field>
            <value>
                <stringValue>Published</stringValue>
            </value>
        </inputAssignments>
        <object>Wisdom_Insight__c</object>
    </recordUpdates>
    <status>Draft</status>
</Flow>
