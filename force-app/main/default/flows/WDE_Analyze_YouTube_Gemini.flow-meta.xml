<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>68.0</apiVersion>
  <label>WDE Analyze YouTube with Gemini Interactions</label>
  <interviewLabel>WDE Analyze YouTube {!$Flow.CurrentDateTime}</interviewLabel>
  <processType>AutoLaunchedFlow</processType>
  <status>Draft</status>
  <environments>Default</environments>
  <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
  <start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Check_YouTube_URL</targetReference></connector></start>
  <decisions>
    <name>Check_YouTube_URL</name><label>Validate Public YouTube URL</label><locationX>0</locationX><locationY>0</locationY>
    <defaultConnector><targetReference>Invalid_URL</targetReference></defaultConnector>
    <defaultConnectorLabel>Invalid URL</defaultConnectorLabel>
    <rules><name>Valid_Watch_URL</name><conditionLogic>or</conditionLogic>
      <conditions><leftValueReference>varT_YouTubeUrl</leftValueReference><operator>StartsWith</operator><rightValue><stringValue>https://www.youtube.com/watch?v=</stringValue></rightValue></conditions>
      <conditions><leftValueReference>varT_YouTubeUrl</leftValueReference><operator>StartsWith</operator><rightValue><stringValue>https://youtu.be/</stringValue></rightValue></conditions>
      <connector><targetReference>Set_Text_Input</targetReference></connector>
      <label>Valid YouTube URL</label></rules>
  </decisions>
  <assignments>
    <name>Invalid_URL</name><label>Reject Invalid URL</label><locationX>0</locationX><locationY>0</locationY>
    <assignmentItems><assignToReference>varT_Error</assignToReference><operator>Assign</operator><value><stringValue>Public YouTube URL required.</stringValue></value></assignmentItems>
  </assignments>
  <assignments>
    <name>Set_Text_Input</name><label>Set Analysis Prompt</label><locationX>0</locationX><locationY>0</locationY>
    <assignmentItems><assignToReference>varS_TextInput.type</assignToReference><operator>Assign</operator><value><stringValue>text</stringValue></value></assignmentItems>
    <assignmentItems><assignToReference>varS_TextInput.text</assignToReference><operator>Assign</operator><value><elementReference>varT_Prompt</elementReference></value></assignmentItems>
    <connector><targetReference>Set_Video_Input</targetReference></connector>
  </assignments>
  <assignments>
    <name>Set_Video_Input</name><label>Set Video Reference</label><locationX>0</locationX><locationY>0</locationY>
    <assignmentItems><assignToReference>varS_VideoInput.type</assignToReference><operator>Assign</operator><value><stringValue>video</stringValue></value></assignmentItems>
    <assignmentItems><assignToReference>varS_VideoInput.uri</assignToReference><operator>Assign</operator><value><elementReference>varT_YouTubeUrl</elementReference></value></assignmentItems>
    <connector><targetReference>Build_Request</targetReference></connector>
  </assignments>
  <assignments>
    <name>Build_Request</name><label>Build Gemini Request</label><locationX>0</locationX><locationY>0</locationY>
    <assignmentItems><assignToReference>varS_Body.model</assignToReference><operator>Assign</operator><value><stringValue>gemini-3.8-flash</stringValue></value></assignmentItems>
    <assignmentItems><assignToReference>varS_Body.store</assignToReference><operator>Assign</operator><value><booleanValue>false</booleanValue></value></assignmentItems>
    <assignmentItems><assignToReference>varS_Body.response_format.type</assignToReference><operator>Assign</operator><value><stringValue>text</stringValue></value></assignmentItems>
    <assignmentItems><assignToReference>varS_Body.response_format.mime_type</assignToReference><operator>Assign</operator><value><stringValue>application/json</stringValue></value></assignmentItems>
    <assignmentItems><assignToReference>varS_Body.input</assignToReference><operator>Add</operator><value><elementReference>varS_TextInput</elementReference></value></assignmentItems>
    <assignmentItems><assignToReference>varS_Body.input</assignToReference><operator>Add</operator><value><elementReference>varS_VideoInput</elementReference></value></assignmentItems>
    <connector><targetReference>Call_Gemini_Interactions</targetReference></connector>
  </assignments>
  <actionCalls>
    <name>Call_Gemini_Interactions</name><label>Analyze YouTube with Gemini</label><locationX>0</locationX><locationY>0</locationY>
    <actionName>WDEGeminiInteractions.createInteraction</actionName>
    <actionType>externalService</actionType>
    <nameSegment>WDEGeminiInteractions.createInteraction</nameSegment>
    <offset>0</offset>
    <flowTransactionModel>Automatic</flowTransactionModel>
    <inputParameters><name>body</name><value><elementReference>varS_Body</elementReference></value></inputParameters>
    <outputParameters><name>2XX</name><assignToReference>varS_Response</assignToReference></outputParameters>
    <outputParameters><name>responseCode</name><assignToReference>varN_ResponseCode</assignToReference></outputParameters>
    <outputParameters><name>defaultExc</name><assignToReference>varT_Error</assignToReference></outputParameters>
    <connector><targetReference>Check_HTTP_Result</targetReference></connector>
    <faultConnector><targetReference>Callout_Fault</targetReference></faultConnector>
  </actionCalls>
  <decisions>
    <name>Check_HTTP_Result</name><label>Check Gemini Result</label><locationX>0</locationX><locationY>0</locationY>
    <defaultConnector><targetReference>HTTP_Failed</targetReference></defaultConnector>
    <defaultConnectorLabel>Not successful</defaultConnectorLabel>
    <rules><name>Completed</name><conditionLogic>and</conditionLogic>
      <conditions><leftValueReference>varN_ResponseCode</leftValueReference><operator>EqualTo</operator><rightValue><numberValue>200</numberValue></rightValue></conditions>
      <conditions><leftValueReference>varS_Response.status</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>completed</stringValue></rightValue></conditions>
      <connector><targetReference>Set_Success</targetReference></connector><label>Completed</label>
    </rules>
  </decisions>
  <assignments>
    <name>Set_Success</name><label>Set Success</label><locationX>0</locationX><locationY>0</locationY>
    <assignmentItems><assignToReference>varB_Success</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems>
  </assignments>
  <assignments>
    <name>HTTP_Failed</name><label>Set Response Error</label><locationX>0</locationX><locationY>0</locationY>
    <assignmentItems><assignToReference>varT_Error</assignToReference><operator>Assign</operator><value><stringValue>Gemini Interaction did not complete successfully; inspect responseCode and response.status.</stringValue></value></assignmentItems>
  </assignments>
  <assignments>
    <name>Callout_Fault</name><label>Capture Callout Fault</label><locationX>0</locationX><locationY>0</locationY>
    <assignmentItems><assignToReference>varT_Error</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
  </assignments>
  <variables><name>varT_YouTubeUrl</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
  <variables><name>varT_Prompt</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
  <variables><name>varS_TextInput</name><dataType>Apex</dataType><apexClass>ExternalService__WDEGeminiInteractions_interactions_IN_body_input</apexClass><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
  <variables><name>varS_VideoInput</name><dataType>Apex</dataType><apexClass>ExternalService__WDEGeminiInteractions_interactions_IN_body_input</apexClass><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
  <variables><name>varS_Body</name><dataType>Apex</dataType><apexClass>ExternalService__WDEGeminiInteractions_interactions_IN_body</apexClass><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
  <variables><name>varS_Response</name><dataType>Apex</dataType><apexClass>ExternalService__WDEGeminiInteractions_interactions_OUT_2XX</apexClass><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
  <variables><name>varN_ResponseCode</name><dataType>Number</dataType><scale>0</scale><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
  <variables><name>varT_Error</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
  <variables><name>varB_Success</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput><value><booleanValue>false</booleanValue></value></variables>
</Flow>
