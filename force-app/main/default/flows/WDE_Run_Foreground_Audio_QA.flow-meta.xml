<formulas><name>f_ClipValid</name><dataType>Boolean</dataType><expression>AND(NOT(ISBLANK({!Get_Claim.Id})), {!Get_Claim.State__c} = "RESERVED", NOT(ISBLANK({!Get_Claim.Segment__c})), {!Get_Claim.Start_Ms__c} &gt;= 0, {!Get_Claim.End_Ms__c} &gt; {!Get_Claim.Start_Ms__c}, {!Get_Claim.End_Ms__c} - {!Get_Claim.Start_Ms__c} &lt;= 30000)</expression></formulas>
<formulas><name>f_SegmentValid</name><dataType>Boolean</dataType><expression>AND(NOT(ISBLANK({!Get_Segment.Id})), {!Get_Segment.Audio_QA_Required__c}, {!Get_Segment.Audio_QA_Status__c} = "SYSTEM_ERROR", NOT({!Get_Segment.WDE_Stitch_Open__c}), {!Get_Segment.LastModifiedDate} = {!Get_Claim.Source_Modified__c}, {!Get_Segment.Start_Ms__c} &lt;= {!Get_Claim.Start_Ms__c}, {!Get_Segment.End_Ms__c} &gt;= {!Get_Claim.End_Ms__c}, LEN(TRIM({!Get_Segment.Transcript_Text__c})) &gt; 0, LEN({!Get_Segment.Transcript_Text__c}) &lt;= 25000, {!Get_Claim.Fingerprint__c} = LEFT({!Get_Segment.Id} &amp; "-" &amp; TEXT({!Get_Segment.Start_Ms__c}) &amp; "-" &amp; TEXT({!Get_Claim.End_Ms__c}),64))</expression></formulas>
<formulas><name>f_SourceValid</name><dataType>Boolean</dataType><expression>AND(NOT(ISBLANK({!Get_Source.Id})), {!Get_Source.Rights_Status__c}="PermissionGranted", {!Get_Source.LastModifiedDate} = {!Get_Claim.Source_Record_Modified__c}, {!Get_Source.External_Video_Id__c} = {!Get_Claim.Video_Id__c}, LEN({!Get_Source.External_Video_Id__c})=11, REGEX({!Get_Source.External_Video_Id__c}, "[A-Za-z0-9_-]{11}"))</expression></formulas>
<formulas><name>f_SourceURL</name><dataType>String</dataType><expression>"https://www.youtube.com/watch?v=" &amp; {!Get_Claim.Video_Id__c}</expression></formulas>
<formulas><name>f_StartOffset</name><dataType>String</dataType><expression>TEXT(FLOOR({!Get_Claim.Start_Ms__c}/1000)) &amp; "s"</expression></formulas>
<formulas><name>f_EndOffset</name><dataType>String</dataType><expression>TEXT(CEILING({!Get_Claim.End_Ms__c}/1000)) &amp; "s"</expression></formulas>
<formulas><name>f_ModelOK</name><dataType>Boolean</dataType><expression>AND({!varN_ResponseCode} = 200, {!varT_FinishReason} = "STOP", LEN(TRIM({!varT_ModelText})) &gt; 0, LEN({!varT_ModelText}) &lt;= 4000, NOT(CONTAINS(UPPER({!varT_ModelText}), "MEDIA_UNAVAILABLE")))</expression></formulas>
<formulas><name>f_PostSegmentValid</name><dataType>Boolean</dataType><expression>AND(NOT(ISBLANK({!Post_Segment.Id})), {!Post_Segment.LastModifiedDate}={!Get_Claim.Source_Modified__c}, {!Post_Segment.Audio_QA_Status__c}="SYSTEM_ERROR", {!Post_Segment.WDE_Stitch_Open__c}=FALSE)</expression></formulas>
