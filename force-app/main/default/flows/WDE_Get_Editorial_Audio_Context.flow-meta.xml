<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Return_Context</name>
        <label>Return optional review-only context</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varT_EditorialContext</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>tt_EditorialContext</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varB_ContextAvailable</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Unavailable</name>
        <label>Fail closed with no context</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varT_Error</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No eligible post-HIVE plan, linked signal, or fresh AI_VERIFIED source. No editorial context returned.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Need</name>
        <label>Eligible post-HIVE Need?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Unavailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not eligible</defaultConnectorLabel>
        <rules>
            <name>Ready_And_Scored</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Need.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Need.HIVE_Evaluation_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ready</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Need.HIVE_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>60.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Linked_Signal</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Plan</name>
        <label>Plan and linked Need exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Unavailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unavailable</defaultConnectorLabel>
        <rules>
            <name>Has_Plan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Plan.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Plan.Audience_Need__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Need</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_QA</name>
        <label>Verified and fresh audio QA?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Unavailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not verified</defaultConnectorLabel>
        <rules>
            <name>Verified_Fresh</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Source.Gemini_Audio_QA_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AI_VERIFIED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Source.Gemini_Audio_QA_Notes__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Source.Gemini_Video_Analysis_JSON__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Source.Gemini_Audio_QA_Checked_At__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Source.Gemini_Analysis_Validated_At__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Source.Gemini_Audio_QA_Checked_At__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Source.Gemini_Analysis_Validated_At__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Return_Context</targetReference>
            </connector>
            <label>Eligible context</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Signal</name>
        <label>Need and Source have actual audience signal?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Unavailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No link</defaultConnectorLabel>
        <rules>
            <name>Linked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Linked_Signal.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Source</targetReference>
            </connector>
            <label>Linked</label>
        </rules>
    </decisions>
    <description>Read-only post-HIVE editorial audio context for an explicitly selected Content Plan and Sermon Source. Requires a real Audience Signal linking the selected Need and Source, an eligible HIVE Need, and fresh AI_VERIFIED audio QA. No DML, calls, scheduling, scoring, rights approval or automatic reuse.</description>
    <formulas>
        <name>f_BoundedNotes</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Source.Gemini_Audio_QA_Notes__c}, 1200)</expression>
    </formulas>
    <interviewLabel>WDE Editorial Audio Context {!$Flow.CurrentDateTime}</interviewLabel>
    <label>WDE Get Editorial Audio Context</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Linked_Signal</name>
        <label>Confirm audience signal connects plan Need and chosen Source</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Signal</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WDE_Audience_Need__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Need.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Sermon_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_SermonSourceId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WDE_Audience_Signal__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Need</name>
        <label>Read ranked Audience Need</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Need</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Plan.Audience_Need__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WDE_Audience_Need__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Plan</name>
        <label>Find selected Content Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Plan</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_ContentPlanId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WDE_Content_Plan__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Source</name>
        <label>Read selected Source QA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_QA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_SermonSourceId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sermon_Source__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Plan</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>tt_EditorialContext</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>EDITORIAL REFERENCE ONLY — selected Audience Need is already Ready and HIVE score at least 60. Verified is a Gemini second-pass audio assertion, NOT independent or human approval. Source audio scope is only 00:00-00:20. RIGHTS NOT CLEARED BY QA; check rights and obtain editorial approval. Never copy source transcript, speaker likeness, footage or music. Produce original concepts around audience needs without altering classification, urgency, HIVE score or plan priority.
SOURCE AUDIO QA NOTES (untrusted reference):
{!f_BoundedNotes}</text>
    </textTemplates>
    <variables>
        <name>varB_ContextAvailable</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>varT_ContentPlanId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varT_EditorialContext</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varT_Error</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varT_SermonSourceId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
