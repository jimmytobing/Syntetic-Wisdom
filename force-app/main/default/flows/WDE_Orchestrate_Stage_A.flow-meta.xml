<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
        <decisions>
        <name>Check_Batch_State</name><label>Process only expected Stage A state</label>
        <locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>END_ELEMENT_4</targetReference></defaultConnector>
        <defaultConnectorLabel>Stale or already processed</defaultConnectorLabel>
        <rules><name>Ready_For_A</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Batch.Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>Pending</stringValue></rightValue></conditions>
            <connector><targetReference>Get_Open_Segment</targetReference></connector><label>Expected state</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_A</name>
        <label>A succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decide_Retry_A</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other result / failed</defaultConnectorLabel>
        <rules>
            <name>A_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>aResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUCCESS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_A_Review</targetReference>
            </connector>
            <label>A_Success</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Retry_A</name><label>Retry transient or invalid AI output up to three times</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Decide_Terminal_A_Error</targetReference></defaultConnector>
        <defaultConnectorLabel>Fail closed</defaultConnectorLabel>
        <rules><name>Retry_A</name><conditionLogic>and</conditionLogic>
        <conditions><leftValueReference>f_Retry_A_Eligible</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
        <connector><targetReference>Set_A_Retry_Pending</targetReference></connector><label>Safe bounded retry</label></rules>
    </decisions>
    <decisions>
        <name>Decide_Terminal_A_Error</name><label>Terminal provider rejection after bounded attempts</label>
        <locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Set_A_Failure</targetReference></defaultConnector>
        <defaultConnectorLabel>Other permanent failure</defaultConnectorLabel>
        <rules><name>Provider_Unrecoverable</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Batch.Retry_Count__c</leftValueReference><operator>GreaterThanOrEqualTo</operator><rightValue><numberValue>3</numberValue></rightValue></conditions>
            <conditions><leftValueReference>f_Provider_Error_A</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
            <connector><targetReference>Set_A_System_Error</targetReference></connector>
            <label>Provider retry exhausted</label>
        </rules>
    </decisions>

    <formulas>
        <name>f_Retry_A_Eligible</name><dataType>Boolean</dataType>
        <expression>AND(
  BLANKVALUE({!Get_Batch.Retry_Count__c}, 0) &lt; 3,
  OR(
    {!aResult} = &quot;INVALID_AI_FORMAT&quot;,
    {!aResult} = &quot;INVALID_AI_RANGE&quot;,
    {!aResult} = &quot;EMPTY_RESPONSE&quot;,
    AND(
      {!aResult} = &quot;GROQ_ERROR&quot;,
      OR(CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;429&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;500&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;502&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;503&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;504&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;rate limit&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;too many requests&quot;))
    ),
    AND(
      {!aResult} = &quot;FLOW_FAULT&quot;,
      OR(CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;timeout&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;timed out&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;connection&quot;),
         CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;temporar&quot;))
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>f_Next_A_Retry</name><dataType>Number</dataType><scale>0</scale>
        <expression>BLANKVALUE({!Get_Batch.Retry_Count__c},0) + 1</expression>
    </formulas>
    <formulas>
        <name>f_NextRetryAt</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + IF(
  OR(CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;per day&quot;),
     CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;daily&quot;),
     CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;tokens per day&quot;),
     CONTAINS(LOWER(BLANKVALUE({!varT_Error}, &quot;&quot;)), &quot;requests per day&quot;)),
  1440,
  CASE(TEXT(BLANKVALUE({!Get_Batch.Retry_Count__c}, 0)), &quot;0&quot;, 1, &quot;1&quot;, 5, 15)
) / 1440</expression>
    </formulas>
    <formulas><name>f_Provider_Error_A</name><dataType>Boolean</dataType>
    <expression>OR({!aResult} = "INVALID_AI_FORMAT", {!aResult} = "INVALID_AI_RANGE", {!aResult} = "EMPTY_RESPONSE", {!aResult} = "GROQ_ERROR")</expression>
</formulas>
    <description>Autolaunched orchestration extracted from Stage A async trigger. Owns the worker, status transitions, retry handling, and persisted batch errors. Issue 53.</description>
