<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
        <decisions>
        <name>Check_Batch_State</name><label>Process only expected Stage C state</label>
        <locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>END_ELEMENT_4</targetReference></defaultConnector>
        <defaultConnectorLabel>Stale or already processed</defaultConnectorLabel>
        <rules><name>Ready_For_C</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Batch.Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>CommitApproved</stringValue></rightValue></conditions>
            <connector><targetReference>Call_C</targetReference></connector><label>Expected state</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_C</name>
        <label>C succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_C_Failure</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other result / failed</defaultConnectorLabel>
        <rules>
            <name>C_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>cResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUCCESS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_C_Complete</targetReference>
            </connector>
            <label>C_Success</label>
        </rules>
    </decisions>
