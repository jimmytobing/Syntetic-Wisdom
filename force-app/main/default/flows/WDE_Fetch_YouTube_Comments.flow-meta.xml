<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Fetch_YouTube_Comments</name>
        <label>Fetch one YouTube comment page</label>
        <locationX>0</locationX><locationY>0</locationY>
        <actionName>YouTubeApiCallout.commentThreads</actionName>
        <actionType>externalService</actionType>
        <connector><targetReference>Check_YouTube_Response</targetReference></connector>
        <faultConnector><targetReference>Capture_Fault</targetReference></faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters><name>part</name><value><stringValue>snippet</stringValue></value></inputParameters>
        <inputParameters><name>videoId</name><value><elementReference>varS_VideoId</elementReference></value></inputParameters>
        <inputParameters><name>maxResults</name><value><elementReference>f_MaxResults</elementReference></value></inputParameters>
        <inputParameters><name>order</name><value><stringValue>time</stringValue></value></inputParameters>
        <nameSegment>YouTubeApiCallout.commentThreads</nameSegment><offset>0</offset>
        <outputParameters><assignToReference>varA_YouTubeResponse</assignToReference><name>2XX</name></outputParameters>
        <outputParameters><assignToReference>varN_YouTubeResponseCode</assignToReference><name>responseCode</name></outputParameters>
        <outputParameters><assignToReference>varS_Error</assignToReference><name>defaultExc</name></outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Classify_Comment_Batch</name>
        <label>Classify one comment batch with Groq</label>
        <locationX>0</locationX><locationY>0</locationY>
        <actionName>WDEGroqService.Generate Wisdom</actionName>
        <actionType>externalService</actionType>
        <connector><targetReference>Check_Groq_Response</targetReference></connector>
        <faultConnector><targetReference>Capture_Fault</targetReference></faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters><name>body</name><value><elementReference>varA_GroqRequest</elementReference></value></inputParameters>
        <nameSegment>WDEGroqService.Generate Wisdom</nameSegment><offset>0</offset>
        <outputParameters><assignToReference>varA_GroqResponse</assignToReference><name>2XX</name></outputParameters>
        <outputParameters><assignToReference>varN_GroqResponseCode</assignToReference><name>responseCode</name></outputParameters>
        <outputParameters><assignToReference>varS_Error</assignToReference><name>defaultExc</name></outputParameters>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Append_Comment_To_Batch</name><label>Append comment to transient batch</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varS_BatchPrompt</assignToReference><operator>Assign</operator><value><elementReference>txtAppendComment</elementReference></value></assignmentItems>
        <connector><targetReference>Loop_Build_Batch</targetReference></connector>
    </assignments>
    <assignments>
        <name>Prepare_Groq_Messages</name><label>Prepare Groq messages</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varA_SystemMessage.role</assignToReference><operator>Assign</operator><value><stringValue>system</stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>varA_SystemMessage.content</assignToReference><operator>Assign</operator><value><elementReference>txtSystemPrompt</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varA_UserMessage.role</assignToReference><operator>Assign</operator><value><stringValue>user</stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>varA_UserMessage.content</assignToReference><operator>Assign</operator><value><elementReference>txtUserPrompt</elementReference></value></assignmentItems>
        <connector><targetReference>Add_Groq_Messages</targetReference></connector>
    </assignments>
    <assignments>
        <name>Add_Groq_Messages</name><label>Add Groq messages</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>colA_GroqMessages</assignToReference><operator>Add</operator><value><elementReference>varA_SystemMessage</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>colA_GroqMessages</assignToReference><operator>Add</operator><value><elementReference>varA_UserMessage</elementReference></value></assignmentItems>
        <connector><targetReference>Set_Groq_Request</targetReference></connector>
    </assignments>
    <assignments>
        <name>Set_Groq_Request</name><label>Set Groq request</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varA_GroqRequest.model</assignToReference><operator>Assign</operator><value><stringValue>openai/gpt-oss-120b</stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>varA_GroqRequest.temperature</assignToReference><operator>Assign</operator><value><numberValue>0.0</numberValue></value></assignmentItems>
        <assignmentItems><assignToReference>varA_GroqRequest.maxx5fcompletionx5ftokens</assignToReference><operator>Assign</operator><value><numberValue>4000.0</numberValue></value></assignmentItems>
        <assignmentItems><assignToReference>varA_GroqRequest.reasoningx5feffort</assignToReference><operator>Assign</operator><value><stringValue>low</stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>varA_GroqRequest.messages</assignToReference><operator>Assign</operator><value><elementReference>colA_GroqMessages</elementReference></value></assignmentItems>
        <connector><targetReference>Classify_Comment_Batch</targetReference></connector>
    </assignments>
    <assignments>
        <name>Capture_Groq_Content</name><label>Capture Groq content</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varS_ClassificationOutput</assignToReference><operator>Assign</operator><value><elementReference>Loop_Groq_Choices.message.content</elementReference></value></assignmentItems>
        <connector><targetReference>Loop_Groq_Choices</targetReference></connector>
    </assignments>
    <assignments>
        <name>Prepare_Current_Signal</name><label>Prepare anonymous signal</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varB_IsDuplicate</assignToReference><operator>Assign</operator><value><booleanValue>false</booleanValue></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal</assignToReference><operator>Assign</operator><value><elementReference>varR_BlankSignal</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Name</assignToReference><operator>Assign</operator><value><elementReference>f_SignalName</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Signal_Key__c</assignToReference><operator>Assign</operator><value><elementReference>f_SignalKey</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Sermon_Source_ExternalKey__c</assignToReference><operator>Assign</operator><value><elementReference>varS_VideoId</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Sermon_Source__c</assignToReference><operator>Assign</operator><value><elementReference>Get_Sermon_Source.Id</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Audience_Need_ExternalKey__c</assignToReference><operator>Assign</operator><value><elementReference>f_NeedKey</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Signal_Date__c</assignToReference><operator>Assign</operator><value><elementReference>f_SignalDate</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Signal_Count__c</assignToReference><operator>Assign</operator><value><numberValue>1.0</numberValue></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Signal_Summary__c</assignToReference><operator>Assign</operator><value><elementReference>f_SignalSummary</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.HIVE_Evidence_Codes__c</assignToReference><operator>Assign</operator><value><elementReference>f_HIVE_EvidenceCodes</elementReference></value></assignmentItems>
        <connector><targetReference>Loop_Audience_Needs</targetReference></connector>
    </assignments>
    <assignments>
        <name>Map_Audience_Need</name><label>Map Audience Need</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varR_CurrentSignal.WDE_Audience_Need__c</assignToReference><operator>Assign</operator><value><elementReference>Loop_Audience_Needs.Id</elementReference></value></assignmentItems>
        <connector><targetReference>Loop_Audience_Needs</targetReference></connector>
    </assignments>
    <assignments>
        <name>Prepare_Existing_Signal_Update</name><label>Prepare existing signal update</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varB_IsDuplicate</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems>
        <assignmentItems><assignToReference>varR_CurrentSignal.Id</assignToReference><operator>Assign</operator><value><elementReference>Loop_Existing_Signals.Id</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>colR_UpdatedSignals</assignToReference><operator>Add</operator><value><elementReference>varR_CurrentSignal</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varN_UpdatedSignalCount</assignToReference><operator>Add</operator><value><numberValue>1.0</numberValue></value></assignmentItems>
        <connector><targetReference>Loop_Existing_Signals</targetReference></connector>
    </assignments>
    <assignments>
        <name>Add_New_Signal</name><label>Add new signal</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>colR_NewSignals</assignToReference><operator>Add</operator><value><elementReference>varR_CurrentSignal</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>varN_NewSignalCount</assignToReference><operator>Add</operator><value><numberValue>1.0</numberValue></value></assignmentItems>
        <connector><targetReference>Loop_Classify_Items</targetReference></connector>
    </assignments>
    <assignments>
        <name>Capture_Fault</name><label>Capture fault</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Groq_Error</name><label>Set Groq error</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><elementReference>f_GroqError</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Missing_Source_Error</name><label>Set missing Sermon Source error</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><elementReference>f_MissingSourceError</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Set_YouTube_Error</name><label>Set YouTube response error</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><elementReference>f_YouTubeError</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Mapping_Error</name><label>Set Audience Need mapping error</label><locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><elementReference>f_MappingError</elementReference></value></assignmentItems>
        <connector><targetReference>Loop_Classify_Items</targetReference></connector>
    </assignments>
    <decisions>
        <name>Check_Sermon_Source</name><label>Check Sermon Source</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Set_Missing_Source_Error</targetReference></defaultConnector><defaultConnectorLabel>Missing</defaultConnectorLabel>
        <rules><name>Source_Found</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Sermon_Source.Id</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <connector><targetReference>Fetch_YouTube_Comments</targetReference></connector><label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_YouTube_Response</name><label>Check YouTube response</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Set_YouTube_Error</targetReference></defaultConnector><defaultConnectorLabel>Invalid or empty</defaultConnectorLabel>
        <rules><name>YouTube_Succeeded</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>varN_YouTubeResponseCode</leftValueReference><operator>GreaterThanOrEqualTo</operator><rightValue><numberValue>200.0</numberValue></rightValue></conditions>
            <conditions><leftValueReference>varN_YouTubeResponseCode</leftValueReference><operator>LessThan</operator><rightValue><numberValue>300.0</numberValue></rightValue></conditions>
            <conditions><leftValueReference>varA_YouTubeResponse.items</leftValueReference><operator>IsEmpty</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <connector><targetReference>Get_Audience_Needs</targetReference></connector><label>2XX with comments</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Groq_Response</name><label>Check Groq response</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Set_Groq_Error</targetReference></defaultConnector><defaultConnectorLabel>Invalid</defaultConnectorLabel>
        <rules><name>Groq_Succeeded</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>varN_GroqResponseCode</leftValueReference><operator>GreaterThanOrEqualTo</operator><rightValue><numberValue>200.0</numberValue></rightValue></conditions>
            <conditions><leftValueReference>varN_GroqResponseCode</leftValueReference><operator>LessThan</operator><rightValue><numberValue>300.0</numberValue></rightValue></conditions>
            <connector><targetReference>Loop_Groq_Choices</targetReference></connector><label>2XX</label>
        </rules>
    </decisions>
    <decisions>
        <name>Audience_Need_Matches</name><label>Audience Need matches</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Loop_Audience_Needs</targetReference></defaultConnector><defaultConnectorLabel>No</defaultConnectorLabel>
        <rules><name>Need_Match</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Loop_Audience_Needs.Need_Key__c</leftValueReference><operator>EqualTo</operator><rightValue><elementReference>f_NeedKey</elementReference></rightValue></conditions>
            <connector><targetReference>Map_Audience_Need</targetReference></connector><label>Match</label>
        </rules>
    </decisions>
    <decisions>
        <name>Existing_Signal_Matches</name><label>Existing signal matches</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Loop_Existing_Signals</targetReference></defaultConnector><defaultConnectorLabel>No</defaultConnectorLabel>
        <rules><name>Duplicate_Key</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Loop_Existing_Signals.Signal_Key__c</leftValueReference><operator>EqualTo</operator><rightValue><elementReference>varR_CurrentSignal.Signal_Key__c</elementReference></rightValue></conditions>
            <connector><targetReference>Prepare_Existing_Signal_Update</targetReference></connector><label>Update existing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Classification_Is_Actionable</name><label>Classification is actionable</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Loop_Classify_Items</targetReference></defaultConnector><defaultConnectorLabel>Skip unclear or generic comment</defaultConnectorLabel>
        <rules><name>Has_Category_And_Summary</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>f_Category</leftValueReference><operator>IsBlank</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <conditions><leftValueReference>f_SignalSummary</leftValueReference><operator>IsBlank</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><conditions><leftValueReference>f_HIVE_EvidenceCodes</leftValueReference><operator>IsBlank</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <connector><targetReference>Prepare_Current_Signal</targetReference></connector><label>Actionable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Add_Signal</name><label>Should add signal</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Set_Mapping_Error</targetReference></defaultConnector><defaultConnectorLabel>Mapping missing</defaultConnectorLabel>
        <rules><name>Existing_Record_Handled</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>varB_IsDuplicate</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
            <connector><targetReference>Loop_Classify_Items</targetReference></connector><label>Already prepared for update</label>
        </rules>
        <rules><name>New_And_Mapped</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>varB_IsDuplicate</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <conditions><leftValueReference>varR_CurrentSignal.WDE_Audience_Need__c</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <connector><targetReference>Add_New_Signal</targetReference></connector><label>Add</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Updated_Signals</name><label>Has updated signals</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Has_New_Signals</targetReference></defaultConnector><defaultConnectorLabel>None</defaultConnectorLabel>
        <rules><name>Records_To_Update</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>varN_UpdatedSignalCount</leftValueReference><operator>GreaterThan</operator><rightValue><numberValue>0.0</numberValue></rightValue></conditions>
            <connector><targetReference>Update_Existing_Signals</targetReference></connector><label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_New_Signals</name><label>Has new signals</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules><name>Records_To_Create</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>varN_NewSignalCount</leftValueReference><operator>GreaterThan</operator><rightValue><numberValue>0.0</numberValue></rightValue></conditions>
            <connector><targetReference>Create_Anonymous_Signals</targetReference></connector><label>Yes</label>
        </rules>
    </decisions>
    <description>Flow-first ingestion of one YouTube page. It batches up to 100 top-level comments into one Groq classification call, maps the deterministic category to Audience Need, deduplicates by Signal_Key__c, and performs one bulk create outside loops. Author identity and raw comment text are never persisted.</description>
    <environments>Default</environments>
    <formulas><name>f_MaxResults</name><dataType>Number</dataType><expression>MIN(100, MAX(1, {!varN_MaxResults}))</expression><scale>0</scale></formulas>
    <formulas><name>f_RubricPrefix</name><dataType>String</dataType><expression>{!Loop_Classify_Items.id} &amp; &quot;|&quot; &amp; {!f_Category} &amp; &quot;|&quot; &amp; {!f_Context} &amp; &quot;|&quot;</expression></formulas>
    <formulas><name>f_UrgencyCode</name><dataType>String</dataType><expression>IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; &quot;U4|Q&quot;), &quot;U4&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; &quot;U3|Q&quot;), &quot;U3&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; &quot;U2|Q&quot;), &quot;U2&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; &quot;U1|Q&quot;), &quot;U1&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; &quot;U0|Q&quot;), &quot;U0&quot;, &quot;&quot;)))))</expression></formulas>
    <formulas><name>f_QualityCode</name><dataType>String</dataType><expression>IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; {!f_UrgencyCode} &amp; &quot;|Q3|END&quot;), &quot;Q3&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; {!f_UrgencyCode} &amp; &quot;|Q2|END&quot;), &quot;Q2&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!f_RubricPrefix} &amp; {!f_UrgencyCode} &amp; &quot;|Q1|END&quot;), &quot;Q1&quot;, &quot;&quot;)))</expression></formulas>
    <formulas><name>f_HIVE_EvidenceCodes</name><dataType>String</dataType><expression>IF(OR(ISBLANK({!f_UrgencyCode}),ISBLANK({!f_QualityCode})),&quot;&quot;,{!f_UrgencyCode} &amp; &quot;|&quot; &amp; {!f_QualityCode} &amp; &quot;|V1&quot;)</expression></formulas>
    <formulas><name>f_SignalKey</name><dataType>String</dataType><expression>&quot;YT:&quot; &amp; {!varS_VideoId} &amp; &quot;:&quot; &amp; {!Loop_Classify_Items.id}</expression></formulas>
    <formulas><name>f_SignalName</name><dataType>String</dataType><expression>LEFT(&quot;Anonymous YouTube signal &quot; &amp; {!Loop_Classify_Items.id}, 80)</expression></formulas>
    <formulas><name>f_SignalDate</name><dataType>Date</dataType><expression>DATEVALUE(TEXT({!Loop_Classify_Items.snippet.topLevelComment.snippet.publishedAt}))</expression></formulas>
    <formulas><name>f_Category</name><dataType>String</dataType><expression>IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|Health|&quot;), &quot;Health&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|Family|&quot;), &quot;Family&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|Finance|&quot;), &quot;Finance&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|Relationship|&quot;), &quot;Relationship&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|Emotional|&quot;), &quot;Emotional&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|Spiritual|&quot;), &quot;Spiritual&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|Other|&quot;), &quot;Other&quot;, &quot;&quot;)))))))</expression></formulas>
    <formulas><name>f_NeedKey</name><dataType>String</dataType><expression>IF(ISBLANK({!f_Category}), &quot;&quot;, &quot;NEED:&quot; &amp; UPPER({!f_Category}))</expression></formulas>
    <formulas><name>f_Context</name><dataType>String</dataType><expression>IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|&quot; &amp; {!f_Category} &amp; &quot;|FAR_FROM_FAMILY|U&quot;), &quot;FAR_FROM_FAMILY&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|&quot; &amp; {!f_Category} &amp; &quot;|FAMILY_SUPPORT|U&quot;), &quot;FAMILY_SUPPORT&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|&quot; &amp; {!f_Category} &amp; &quot;|EMOTIONAL_SUPPORT|U&quot;), &quot;EMOTIONAL_SUPPORT&quot;, IF(CONTAINS({!varS_ClassificationOutput}, {!Loop_Classify_Items.id} &amp; &quot;|&quot; &amp; {!f_Category} &amp; &quot;|PRAYER_SUPPORT|U&quot;), &quot;PRAYER_SUPPORT&quot;, &quot;NONE&quot;))))</expression></formulas>
    <formulas><name>f_SignalSummary</name><dataType>String</dataType><expression>IF(ISBLANK({!f_Category}), &quot;&quot;, CASE({!f_Category}, &quot;Health&quot;, IF({!f_Context} = &quot;FAR_FROM_FAMILY&quot;, &quot;Menghadapi kondisi kesehatan dan membutuhkan dukungan saat jauh dari keluarga.&quot;, &quot;Menghadapi kondisi kesehatan dan membutuhkan dukungan.&quot;), &quot;Family&quot;, &quot;Menghadapi kebutuhan keluarga dan membutuhkan dukungan.&quot;, &quot;Finance&quot;, &quot;Menghadapi kebutuhan keuangan dan membutuhkan dukungan.&quot;, &quot;Relationship&quot;, &quot;Menghadapi kebutuhan relasi dan membutuhkan dukungan.&quot;, &quot;Emotional&quot;, &quot;Menghadapi beban emosional dan membutuhkan dukungan.&quot;, &quot;Spiritual&quot;, &quot;Membutuhkan bimbingan dan dukungan spiritual.&quot;, &quot;Other&quot;, &quot;Menghadapi kebutuhan lain yang jelas dan membutuhkan dukungan.&quot;, &quot;&quot;))</expression></formulas>
    <formulas><name>f_GroqError</name><dataType>String</dataType><expression>&quot;Groq classification failed. HTTP &quot; &amp; TEXT({!varN_GroqResponseCode}) &amp; &quot;. &quot; &amp; {!varS_Error}</expression></formulas>
    <formulas><name>f_YouTubeError</name><dataType>String</dataType><expression>&quot;YouTube returned no processable comments or failed. HTTP &quot; &amp; TEXT({!varN_YouTubeResponseCode}) &amp; &quot;. &quot; &amp; {!varS_Error}</expression></formulas>
    <formulas><name>f_MissingSourceError</name><dataType>String</dataType><expression>&quot;No Sermon_Source__c found for External_Video_Id__c=&quot; &amp; {!varS_VideoId} &amp; &quot;. No signal records were written.&quot;</expression></formulas>
