<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_A</name>
        <label>A succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_A_Failure</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other result / failed</defaultConnectorLabel>
        <rules>
            <name>A_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>aResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUCCESS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_A_Review</targetReference>
            </connector>
            <label>A_Success</label>
        </rules>
    </decisions>
    <description>WDE Batch 8 pilot — asynchronous stage A; no automatic approval. Deploy inactive and validate in sandbox first.</description>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>[Tgr] WDE Run Stage A {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Tgr] WDE Run Stage A</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>ok</description>
        <name>Get_Open_Segment</name>
        <label>Get Open Segment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Call_A</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Sermon_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Sermon_Source__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>WDE_Stitch_Open__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sermon_Segment__c</object>
        <sortField>End_Index__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Set_A_Failure</name>
        <label>Stage A failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Error_Message__c</field>
            <value>
                <elementReference>aError</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_A_Review</name>
        <label>Store A draft for review</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_6</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Draft_Boundaries__c</field>
            <value>
                <elementReference>aRaw</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Next_Start_Position__c</field>
            <value>
                <elementReference>aNext</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>NeedsReview</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <object>WDE_Batch_Run__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Open_Segment</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_A</name>
        <label>Call_A</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_A</targetReference>
        </connector>
        <flowName>WDE_Semantic_Segmentation_Batch</flowName>
        <inputAssignments>
            <name>varSermonSourceId</name>
            <value>
                <elementReference>$Record.Sermon_Source__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varStartPosition</name>
            <value>
                <elementReference>$Record.Start_Position__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varMaxBatchCharacters</name>
            <value>
                <elementReference>$Record.Max_Batch_Characters__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varPriorOpenTopic</name>
            <value>
                <elementReference>Get_Open_Segment.Topic__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varPriorOpenSummary</name>
            <value>
                <elementReference>Get_Open_Segment.Summary__c</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>aResult</assignToReference>
            <name>varResultStatus</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>aError</assignToReference>
            <name>varErrorMessage</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>aRaw</assignToReference>
            <name>varGroqResponseText</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>aNext</assignToReference>
            <name>varNextStartPosition</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>aError</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>aNext</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>aRaw</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>aResult</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
