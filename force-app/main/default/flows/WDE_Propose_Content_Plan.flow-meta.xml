<assignments><name>Capture_Fault</name><label>Capture DML fault</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems></assignments>
<recordCreates><name>Create_Content_Plan</name><label>Persist one proposal</label><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Set_New_Created</targetReference></connector><faultConnector><targetReference>Capture_Fault</targetReference></faultConnector><inputReference>varR_NewPlan</inputReference></recordCreates>
<start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Get_Audience_Need</targetReference></connector></start>
