<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
<apiVersion>68.0</apiVersion>
<description>Idempotently create a weekly YouTube Shorts proposal for a scored Need. Only Proposed status; human approval required before production/publication. No callouts.</description>
<interviewLabel>WDE Propose Content Plan {!$Flow.CurrentDateTime}</interviewLabel>
<label>WDE Propose Content Plan</label>
<processType>AutoLaunchedFlow</processType>
<status>Draft</status>
<variables><name>varS_NeedId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
<variables><name>varB_Success</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
<variables><name>varB_Created</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
<variables><name>varS_Error</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
<variables><name>varR_NewPlan</name><dataType>SObject</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><objectType>WDE_Content_Plan__c</objectType></variables>
<formulas><name>f_Week_Start</name><dataType>Date</dataType><expression>TODAY()-MOD(WEEKDAY(TODAY())+5,7)</expression></formulas>
<formulas><name>f_Plan_Key</name><dataType>String</dataType><expression>{!Get_Audience_Need.Need_Key__c} &amp; &quot;|YOUTUBE_SHORTS|&quot; &amp; TEXT({!f_Week_Start})</expression></formulas>
<formulas><name>f_Plan_Name</name><dataType>String</dataType><expression>LEFT({!Get_Audience_Need.Name} &amp; &quot; - &quot; &amp; TEXT({!f_Week_Start}),80)</expression></formulas>
<formulas><name>f_Topic</name><dataType>String</dataType><expression>LEFT(&quot;Wisdom Shorts: &quot; &amp; {!Get_Audience_Need.Name},255)</expression></formulas>
<formulas><name>f_Has_Need_Key</name><dataType>Boolean</dataType><expression>NOT(ISBLANK({!Get_Audience_Need.Need_Key__c}))</expression></formulas>
<recordLookups><name>Get_Audience_Need</name><label>Get source Audience Need</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Need_Found</targetReference></connector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varS_NeedId</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>WDE_Audience_Need__c</object><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>
<recordLookups><name>Get_Existing_Plan</name><label>Get proposal by stable Plan Key</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Plan_Exists</targetReference></connector><filterLogic>and</filterLogic><filters><field>Plan_Key__c</field><operator>EqualTo</operator><value><elementReference>f_Plan_Key</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>WDE_Content_Plan__c</object><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>
<decisions><name>Need_Found</name><label>Audience Need exists</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Set_Not_Found</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>Found</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Audience_Need.Id</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Is_Eligible</targetReference></connector><label>Found</label></rules></decisions>
<decisions><name>Is_Eligible</name><label>Ready score above review threshold</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Set_Not_Eligible</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>Eligible</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Audience_Need.HIVE_Evaluation_Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>Ready</stringValue></rightValue></conditions><conditions><leftValueReference>Get_Audience_Need.HIVE_Score__c</leftValueReference><operator>GreaterThanOrEqualTo</operator><rightValue><numberValue>60.0</numberValue></rightValue></conditions><conditions><leftValueReference>f_Has_Need_Key</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions><connector><targetReference>Get_Existing_Plan</targetReference></connector><label>Eligible</label></rules></decisions>
<decisions><name>Plan_Exists</name><label>Do not create duplicate proposal</label><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Prepare_New_Plan</targetReference></defaultConnector><defaultConnectorLabel>Otherwise</defaultConnectorLabel><rules><name>Already_Exists</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Existing_Plan.Id</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Set_Success</targetReference></connector><label>Already_Exists</label></rules></decisions>
<assignments><name>Prepare_New_Plan</name><label>Prepare human-review proposal</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varR_NewPlan.Name</assignToReference><operator>Assign</operator><value><elementReference>f_Plan_Name</elementReference></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Plan_Key__c</assignToReference><operator>Assign</operator><value><elementReference>f_Plan_Key</elementReference></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Audience_Need__c</assignToReference><operator>Assign</operator><value><elementReference>Get_Audience_Need.Id</elementReference></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Need_ExternalKey__c</assignToReference><operator>Assign</operator><value><elementReference>Get_Audience_Need.Need_Key__c</elementReference></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Planning_Period__c</assignToReference><operator>Assign</operator><value><elementReference>f_Week_Start</elementReference></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Status__c</assignToReference><operator>Assign</operator><value><stringValue>Proposed</stringValue></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Platform__c</assignToReference><operator>Assign</operator><value><stringValue>YouTube Shorts</stringValue></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.HIVE_Score_Snapshot__c</assignToReference><operator>Assign</operator><value><elementReference>Get_Audience_Need.HIVE_Score__c</elementReference></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Topic__c</assignToReference><operator>Assign</operator><value><elementReference>f_Topic</elementReference></value></assignmentItems><assignmentItems><assignToReference>varR_NewPlan.Source_As_Of__c</assignToReference><operator>Assign</operator><value><elementReference>$Flow.CurrentDateTime</elementReference></value></assignmentItems><connector><targetReference>Create_Content_Plan</targetReference></connector></assignments>
