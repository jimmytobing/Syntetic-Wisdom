<assignments><name>Set_Success</name><label>Mark existing proposal reused</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varB_Success</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems></assignments>
<assignments><name>Set_Not_Eligible</name><label>Skip until score and review requirements are met</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varS_Error</assignToReference><operator>Assign</operator><value><stringValue>HIVE score not Ready or below 60; no content plan created</stringValue></value></assignmentItems></assignments>
