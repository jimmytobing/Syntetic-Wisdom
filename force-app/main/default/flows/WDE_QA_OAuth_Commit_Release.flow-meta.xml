            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>CommitApproved</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
