<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Mark_Released</name>
        <label>Indicate transaction reached final step</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varB_Released</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Fresh_Batch</name>
        <label>Require fresh held source-bound QA snapshot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Stale or unverified</defaultConnectorLabel>
        <rules>
            <name>Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Batch.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NeedsCommitReview</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Batch.Sermon_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varS_SourceId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Batch.LastModifiedDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varDT_ExpectedModifiedAt</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Batch.QA_Enrichment_SHA256__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varS_EnrichmentDigest</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Batch.Approved_Enrichment__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Claim</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Identity</name>
        <label>Custom Permission required for OAuth QA actor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Denied</defaultConnectorLabel>
        <rules>
            <name>Authorized</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_RequestAuthorized</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Batch</targetReference>
            </connector>
            <label>Authorized QA request</label>
        </rules>
    </decisions>
    <description>Issue 54 Flow-only synchronous QA commit. Salesforce OAuth user must hold WDE_QA_Commit_Release. Unique batch claim CREATE + Batch update + journal commit share one Flow transaction. No pause/async/fault catch; DML failure rolls back all. The QA OAuth issuer supplies independently evaluated PASS and source-bound evidence digest. Never invoke as primary AI user.</description>
    <formulas>
        <name>f_RequestAuthorized</name>
        <dataType>Boolean</dataType>
        <expression>AND(
      {!$Permission.WDE_QA_Commit_Release},
      {!varS_QaVerdict} = &quot;PASS&quot;,
      REGEX({!varS_EnrichmentDigest},&quot;sha256:[0-9a-f]{64}&quot;),
      REGEX({!varS_EvidenceDigest},&quot;sha256:[0-9a-f]{64}&quot;),
      REGEX({!varS_ReleaseKey},&quot;[0-9a-f]{64}&quot;),
      REGEX({!varS_QaVersion},&quot;[A-Za-z0-9][A-Za-z0-9._-]{1,79}&quot;)
    )</expression>
    </formulas>
    <interviewLabel>WDE QA OAuth Commit Release {!$Flow.CurrentDateTime}</interviewLabel>
    <label>WDE QA OAuth Commit Release</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Claim</name>
        <label>INSERT unique QA release claim, never upsert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Batch</targetReference>
        </connector>
        <inputAssignments>
