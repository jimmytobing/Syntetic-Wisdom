<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Existing</name>
        <label>Next batch does not yet exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stop safely</defaultConnectorLabel>
        <rules>
            <name>Not_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Next_Batch.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Current_Open_Segment</targetReference>
            </connector>
            <label>Not_Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Open</name>
        <label>An open segment exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stop safely</defaultConnectorLabel>
        <rules>
            <name>Open_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Open_Segment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Next_Batch</targetReference>
            </connector>
            <label>Open_Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Source</name>
        <label>Source and remaining transcript?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stop safely</defaultConnectorLabel>
        <rules>
            <name>Has_Remaining_Text</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sermon_Source.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Next_Start_Position__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>f_Remaining</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Next_Batch</targetReference>
            </connector>
            <label>Has_Remaining_Text</label>
        </rules>
    </decisions>
    <description>Pilot auto-next batch: creates at most one Pending successor only after Auto_Next_Enabled__c and Completed; guards source length, duplicate Run_Key, and open segment. Next record Auto_Next_Enabled__c=true, continuing after validated completion. Keep Draft until verified.</description>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>f_Next_Batch_Number</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Batch_Number__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Next_Run_Key</name>
        <dataType>String</dataType>
        <expression>&quot;WDE:&quot; &amp; {!$Record.Sermon_Source_External_Key__c} &amp; &quot;:BATCH:&quot; &amp; TEXT({!f_Next_Batch_Number})</expression>
    </formulas>
    <formulas>
        <name>f_Remaining</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.Next_Start_Position__c} &gt; {!$Record.Start_Position__c}, {!$Record.Next_Start_Position__c} &lt;= {!f_Source_Length})</expression>
    </formulas>
    <formulas>
        <name>f_Source_Length</name>
        <dataType>Number</dataType>
        <expression>LEN({!Get_Sermon_Source.Raw_Transcript_Text__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>[Tgr] WDE_Create_Next_Batch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Tgr] WDE_Create_Next_Batch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Next_Batch</name>
        <label>Create one next Pending batch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_3</targetReference>
        </connector>
        <inputAssignments>
            <field>Approval_Mode__c</field>
            <value>
                <stringValue>AutoApproved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Auto_Approved__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Auto_Next_Enabled__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Batch_Number__c</field>
            <value>
                <elementReference>f_Next_Batch_Number</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Max_Batch_Characters__c</field>
            <value>
                <elementReference>$Record.Max_Batch_Characters__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Open_Segment_Key__c</field>
            <value>
                <elementReference>Get_Current_Open_Segment.Segment_Key__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Retry_Count__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Run_Key__c</field>
            <value>
                <elementReference>f_Next_Run_Key</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sermon_Source_External_Key__c</field>
            <value>
                <elementReference>$Record.Sermon_Source_External_Key__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sermon_Source__c</field>
            <value>
                <elementReference>$Record.Sermon_Source__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Start_Position__c</field>
            <value>
                <elementReference>$Record.Next_Start_Position__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <object>WDE_Batch_Run__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Current_Open_Segment</name>
        <label>Find latest open segment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Open</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Sermon_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Sermon_Source__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>WDE_Stitch_Open__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sermon_Segment__c</object>
        <sortField>End_Index__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Next_Batch</name>
        <label>Check next batch Run Key</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Existing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Run_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>f_Next_Run_Key</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WDE_Batch_Run__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Sermon_Source</name>
        <label>Load transcript for EOF guard</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Source</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Sermon_Source__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sermon_Source__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_2</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Auto_Next_Enabled__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Next_Start_Position__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>WDE_Batch_Run__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Sermon_Source</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
