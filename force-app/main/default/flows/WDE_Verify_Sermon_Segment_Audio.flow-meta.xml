<formulas><name>f_SourceURL</name><dataType>String</dataType><expression>"https://www.youtube.com/watch?v=" &amp; {!Get_Sermon_Source.External_Video_Id__c}</expression></formulas>
<formulas><name>f_Valid_Source_Video_Id</name><dataType>Boolean</dataType><expression>AND(LEN({!Get_Sermon_Source.External_Video_Id__c})=11,REGEX({!Get_Sermon_Source.External_Video_Id__c},"[A-Za-z0-9_-]{11}"))</expression></formulas>
<formulas><name>f_StartOffset</name><dataType>String</dataType><expression>TEXT(FLOOR({!Get_Segment.Start_Ms__c}/1000)) &amp; "s"</expression></formulas>
<formulas><name>f_EndOffset</name><dataType>String</dataType><expression>TEXT(CEILING({!Get_Segment.End_Ms__c}/1000)) &amp; "s"</expression></formulas>
<formulas><name>f_Next_Attempt</name><dataType>Number</dataType><scale>0</scale><expression>BLANKVALUE({!Get_Segment.Audio_QA_Attempts__c},0)+1</expression></formulas>
<formulas><name>f_Transcript_Eligible</name><dataType>Boolean</dataType><expression>AND(LEN(TRIM({!Get_Segment.Transcript_Text__c})) &gt; 0,LEN({!Get_Segment.Transcript_Text__c}) &lt;= 25000)</expression></formulas>
<formulas><name>f_Bounded_Transcript</name><dataType>String</dataType><expression>LEFT({!Get_Segment.Transcript_Text__c},25000)</expression></formulas>
<formulas><name>f_Valid_Response</name><dataType>Boolean</dataType><expression>AND(LEN(TRIM({!varT_QA_Result})) &gt; 45,LEN({!varT_QA_Result}) &lt; 8000,OR(BEGINS(TRIM({!varT_QA_Result}),"PASS|"),BEGINS(TRIM({!varT_QA_Result}),"FAIL|"),BEGINS(TRIM({!varT_QA_Result}),"SYSTEM_ERROR|")),CONTAINS({!varT_QA_Result},"AUDIO:"),CONTAINS({!varT_QA_Result},"TIMESTAMPS:"))</expression></formulas>
<formulas><name>f_QA_Verified_Response</name><dataType>Boolean</dataType><expression>BEGINS(TRIM({!varT_QA_Result}),"PASS|")</expression></formulas>
<formulas><name>f_QA_Model_Error</name><dataType>Boolean</dataType><expression>BEGINS(TRIM({!varT_QA_Result}),"SYSTEM_ERROR|")</expression></formulas>
<formulas><name>f_Correction_Text</name><dataType>String</dataType><expression>IF(CONTAINS({!varT_QA_Result},"|CORRECTED_TRANSCRIPT:"),TRIM(MID({!varT_QA_Result},FIND("|CORRECTED_TRANSCRIPT:",{!varT_QA_Result})+LEN("|CORRECTED_TRANSCRIPT:"),8000)),"")</expression></formulas>
<formulas><name>f_Correction_Eligible</name><dataType>Boolean</dataType><expression>AND(
BLANKVALUE({!Get_Segment.Audio_QA_Correction_Attempts__c},0)=0,
LEN({!f_Correction_Text}) &gt;= 30,
LEN({!f_Correction_Text}) &lt;= 25000,
LEN({!f_Correction_Text}) &gt;= 0.7 * LEN({!Get_Segment.Transcript_Text__c}),
LEN({!f_Correction_Text}) &lt;= 1.3 * LEN({!Get_Segment.Transcript_Text__c}),
NOT(CONTAINS({!f_Correction_Text},"|")),
{!f_Correction_Text} &lt;&gt; {!Get_Segment.Transcript_Text__c},
{!varT_FinishReason}="STOP"
)</expression></formulas>
<formulas><name>f_QA_Concluded</name><dataType>Boolean</dataType><expression>OR({!varT_QA_Status}="PASS",{!varT_QA_Status}="FAIL")</expression></formulas>
<formulas><name>f_QA_Notes</name><dataType>String</dataType><expression>LEFT(BLANKVALUE({!varT_QA_Result},BLANKVALUE({!varT_Error},"QA failed without detail")),8000)</expression></formulas>
