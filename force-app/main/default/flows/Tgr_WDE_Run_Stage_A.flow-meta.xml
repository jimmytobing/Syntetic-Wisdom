    <decisions>
        <name>Check_A</name>
        <label>A succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decide_Retry_A</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other result / failed</defaultConnectorLabel>
        <rules>
            <name>A_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>aResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUCCESS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_A_Review</targetReference>
            </connector>
            <label>A_Success</label>
        </rules>
    </decisions>
    <formulas>
        <name>f_Retry_A_Eligible</name><dataType>Boolean</dataType>
        <expression>AND(OR({!aResult} = &quot;INVALID_AI_FORMAT&quot;, {!aResult} = &quot;EMPTY_RESPONSE&quot;, CONTAINS(LOWER({!aError}), &quot;too many requests&quot;)), BLANKVALUE({!$Record.Retry_Count__c}, 0) &lt; 2)</expression>
    </formulas>
    <formulas>
        <name>f_Next_A_Retry</name><dataType>Number</dataType><scale>0</scale>
        <expression>BLANKVALUE({!$Record.Retry_Count__c},0) + 1</expression>
    </formulas>
    <decisions>
        <name>Decide_Retry_A</name><label>Retry malformed AI response at most twice</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Set_A_Failure</targetReference></defaultConnector>
        <defaultConnectorLabel>Fail closed</defaultConnectorLabel>
        <rules><name>Retry_A</name><conditionLogic>and</conditionLogic>
        <conditions><leftValueReference>f_Retry_A_Eligible</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
        <connector><targetReference>Set_A_Retry_Pending</targetReference></connector><label>Safe bounded retry</label></rules>
    </decisions>
