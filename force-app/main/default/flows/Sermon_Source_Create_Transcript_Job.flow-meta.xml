<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Record-Triggered (After Save) on Sermon_Source__c. When Rights_Status = PermissionGranted AND Ingest_Status = Pending, creates a Transcript_Job with a deterministic Job_Key, then advances Ingest_Status to Processing to prevent re-entry. Does not make external callouts — the integration layer polls for Stage=Pending jobs independently.</description>
    <interviewLabel>Sermon Source – Create Transcript Job {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sermon Source – Create Transcript Job</label>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CreateTranscriptJob</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Rights_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PermissionGranted</stringValue>
            </value>
        </filters>
        <filters>
            <field>Ingest_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <object>Sermon_Source__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <formulas>
        <name>frmJobKey</name>
        <dataType>String</dataType>
        <expression><![CDATA["JOB:" & {!$Record.External_Video_Id__c}]]></expression>
    </formulas>
    <recordCreates>
        <name>CreateTranscriptJob</name>
        <label>Create Transcript Job</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <connector>
            <targetReference>UpdateIngestStatus</targetReference>
        </connector>
        <inputAssignments>
            <field>Sermon_Source__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job_Key__c</field>
            <value>
                <elementReference>frmJobKey</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <object>Transcript_Job__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>UpdateIngestStatus</name>
        <label>Update Ingest Status to Processing</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <inputAssignments>
            <field>Ingest_Status__c</field>
            <value>
                <stringValue>Processing</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <status>Draft</status>
</Flow>
